# Full Empire Stack Environment Variables

# Windsurf AI Integration
WINDSURF_KEY=t7AcGQ5mfYdaaIuFOmE4AGy5bdU8RA8mU0uLoOzoZ24
WINDSURF_API_URL=https://api.windsurf.dev
WINDSURF_ENABLED=true

# Empire Configuration
EMPIRE_MODE=ULTRA_LEGENDARY
EMPIRE_ENVIRONMENT=production

# Security Keys (Change in production!)
JWT_SECRET_KEY=legendary_empire_jwt_secret_key_change_in_production
API_SECRET_KEY=ultra_secure_api_secret_key_for_empire_stack

# Database Configuration
DATABASE_URL=postgresql://empire_user:legendary_pass@postgres:5432/hyperfocus_empire
POSTGRES_DB=hyperfocus_empire
POSTGRES_USER=empire_user
POSTGRES_PASSWORD=legendary_pass

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# RabbitMQ Configuration
RABBITMQ_URL=amqp://empire_user:legendary_pass@rabbitmq:5672/
RABBITMQ_DEFAULT_USER=empire_user
RABBITMQ_DEFAULT_PASS=legendary_pass

# MinIO Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=empire_access_key
MINIO_SECRET_KEY=legendary_secret_key
MINIO_ROOT_USER=empire_access_key
MINIO_ROOT_PASSWORD=legendary_secret_key

# Monitoring Configuration
PROMETHEUS_RETENTION=200h
GRAFANA_ADMIN_USER=empire_admin
GRAFANA_ADMIN_PASSWORD=legendary_grafana_pass

# Elasticsearch Configuration
ELASTIC_PASSWORD=legendary_elastic_pass
ELASTIC_USERNAME=elastic

# Nginx Configuration
NGINX_HOST=hyperfocus.zone
NGINX_PORT=80

# Application Ports
COMMAND_CENTER_PORT=8001
API_GATEWAY_PORT=8000
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
MINIO_CONSOLE_PORT=9001
RABBITMQ_MANAGEMENT_PORT=15672
KIBANA_PORT=5601

# Performance Tuning
MAX_CONNECTIONS=100
WORKER_PROCESSES=4
POOL_SIZE=20
CACHE_TTL=3600

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_ROTATION=daily

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
