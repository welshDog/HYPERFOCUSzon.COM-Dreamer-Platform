# 🐳 HyperFocus Zone System Monitor - Docker Ignore
# Optimize Docker builds by excluding unnecessary files

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Git files
.git/
.gitignore
.gitattributes

# Testing and coverage
.tox/
.nox/
.coverage
.pytest_cache/
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Documentation
docs/
*.md
README*
CHANGELOG*
LICENSE*

# Local development files
.local/
temp/
tmp/
*.tmp
*.bak
*.orig

# Log files and data
*.log
logs/
data/
metrics/
*.csv
*.json

# Docker files (avoid recursion)
Dockerfile*
docker-compose*
.dockerignore

# System files
.htaccess
.env.local
.env.development.local
.env.test.local
.env.production.local

# Node modules (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# MacOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# Temporary files
*.swp
*.swo
.tmp/
