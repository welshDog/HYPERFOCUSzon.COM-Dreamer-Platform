def draw_node(x, y, w, h, text, color):
    box = FancyBboxPatch((x, y), w, h, boxstyle="round,pad=0.02,rounding_size=8",
                         linewidth=1.5, edgecolor="black", facecolor= color, alpha=0.9)
    ax.add_patch(box)
    ax.text(x+w/2, y+h/2, text, ha='center', va='center', fontsize=10, color="black")

def arrow(x1, y1, x2, y2, label=None):
    ax.annotate("", xy=(x2, y2), xytext=(x1, y1),
                arrowprops=dict(arrowstyle=ArrowStyle("Simple", head_width=8, head_length=10), lw=1.5))
    if label:
        ax.text((x1+x2)/2, (y1+y2)/2 + 2, label, ha='center', va='bottom', fontsize=9)

