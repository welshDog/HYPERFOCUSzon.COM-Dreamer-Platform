            s.run(\"\"\"
            MERGE (s:Source {id:$sid})
            WITH s
            MATCH (c:Claim {id:$cid})
            MERGE (c)-[r:SUPPORTED_BY]->(s)
            SET r.weight=$w
            \"\"\", cid=claim_id, sid=src_id, w=weight)
