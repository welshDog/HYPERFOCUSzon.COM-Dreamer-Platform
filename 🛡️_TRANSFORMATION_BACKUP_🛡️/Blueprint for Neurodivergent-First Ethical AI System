verifier_check = """# services/verifier/check.py
SOURCE_WEIGHTS = {"paper": 0.95, "org": 0.85, "book": 0.80, "forum": 0.60, "video": 0.60}

def trust_score(evidences):
    ev = evidences or []
    if not ev:
        return 0.0
    weighted = [SOURCE_WEIGHTS.get(e.get("type","forum"),0.5) * float(e.get("match",0)) for e in ev]
    return min(1.0, sum(weighted) / max(1,len(weighted)) + 0.05 * (len(ev)-1))

def verdict(score: float):
    if score >= 0.85: return "✅ Likely True"
    if score >= 0.65: return "🟨 Mixed/Contextual"
    if score >= 0.45: return "⚠️ Unclear"
    return "❌ Unverified/Contradicted"
"""

