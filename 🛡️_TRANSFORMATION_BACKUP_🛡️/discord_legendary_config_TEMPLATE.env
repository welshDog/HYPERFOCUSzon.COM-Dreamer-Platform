# Example bot token configuration file
# Copy this file to one of these names:
# - empire.env
# - .env
# - discord_legendary_config.env

# 🔑 Discord Bot Token (Required)
# Get this from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# 🎯 Optional Configuration
BOT_PREFIX=!
EMPIRE_NAME=HyperFocus Zone
COMMUNITY_TYPE=neurodivergent

# 🌡️ Performance Monitoring Settings
HEAT_MONITORING=enabled
ALERT_THRESHOLD_CPU=85
ALERT_THRESHOLD_MEMORY=90
MONITORING_INTERVAL=300

# 🧠 Ultra Thinking Boardroom Settings
STRATEGIC_ANALYSIS=enabled
PREDICTIVE_INTELLIGENCE=enabled
OPTIMIZATION_MODE=legendary

# ♿ Accessibility Settings
ADHD_OPTIMIZATION=enabled
AUTISM_SUPPORT=enabled
DYSLEXIA_ACCOMMODATION=enabled
DEFAULT_ACCESSIBILITY_PROFILE=ADHD

# 💰 BROski Economy Settings
STARTING_BALANCE=100
DAILY_REWARD_BASE=50
FOCUS_SESSION_MULTIPLIER=2
ACHIEVEMENT_BONUS=enabled

# 🎊 Community Features
CELEBRATION_MODE=enabled
MILESTONE_REWARDS=enabled
CRISIS_SUPPORT=enabled
AUTO_MODERATION=enabled

# 🏰 Zone Configuration
TOTAL_ZONES=10
DYNAMIC_LOADING=enabled
COG_ARCHITECTURE=modular

# 📊 Analytics and Logging
DETAILED_LOGGING=enabled
ANALYTICS_TRACKING=enabled
PERFORMANCE_METRICS=enabled
USER_PRIVACY=protected
