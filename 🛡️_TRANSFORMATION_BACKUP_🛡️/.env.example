# 🔐 HYPERFOCUS ZONE EMPIRE - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control!

# 🤖 Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
PUBLIC_KEY=your_public_key_here
APPLICATION_ID=your_application_id_here
OAUTH2_CLIENT_ID=your_oauth2_client_id_here
CLIENT_SECRET=your_client_secret_here


# 🌐 API Endpoints
PI_API_ENDPOINT=https://your-pi-endpoint.com
GEMINI_API_KEY=your_gemini_api_key_here

# 🏗️ Development Settings
DEBUG_MODE=true
ENVIRONMENT=development

# 🔗 Database Configuration
DATABASE_URL=your_database_url_here

# 🌊 Memory Crystal Configuration
MEMORY_CRYSTAL_VAULT_PATH=h:/🔮💎_MEMORY_CRYSTAL_VAULT_💎🔮
BACKUP_CRYSTAL_PATH=h:/memory_crystals_backup

# 🎯 ADHD Optimization
HYPERFOCUS_MODE=enabled
DOPAMINE_NOTIFICATIONS=true

# 🚀 Empire Settings
EMPIRE_ROOT_PATH=h:/
LEGENDARY_STATUS_THRESHOLD=720

# 📊 Monitoring
GRAFANA_ENDPOINT=http://localhost:3000
PROMETHEUS_ENDPOINT=http://localhost:9090

# 🔒 Security
SECURITY_SCAN_ENABLED=true
AUTO_BACKUP_ENABLED=true
