### Minimal PyTorch pattern: ER + EWC

```python
# Pseudocode: continual loop with Experience Replay (ER) + EWC
model = Net()
opt = torch.optim.Adam(model.parameters(), lr=3e-4)
buffer = ReplayBuffer(capacity=2000)  # small, class-balanced

ewc_importance = defaultdict(float)   # Fisher diag per param
ewc_star = {}                         # snapshot of old weights
lambda_ewc = 10.0

def ewc_penalty(model):
    loss = 0.0
    for n, p in model.named_parameters():
        if n in ewc_star:
            loss += (ewc_importance[n] * (p - ewc_star[n]).pow(2)).sum()
    return loss

for task in stream_of_tasks():  # or chunks of evolving data
    for x_new, y_new in task_loader(task):
        x_rep, y_rep = buffer.sample(batch_size=len(x_new)//2)
        x = torch.cat([x_new, x_rep], 0)
        y = torch.cat([y_new, y_rep], 0)

        logits = model(x)
        ce = F.cross_entropy(logits, y)

        loss = ce + lambda_ewc * ewc_penalty(model)
        opt.zero_grad(); loss.backward(); opt.step()

        buffer.add_batch(x_new.detach(), y_new.detach())

    # After finishing the task/chunk, estimate Fisher and snapshot weights
    ewc_importance.clear()
    for x_fish, y_fish in fisher_loader(task, n=512):
        model.zero_grad()
        F.nll_loss(F.log_softmax(model(x_fish), dim=1), y_fish).backward()
        for n, p in model.named_parameters():
            if p.grad is not None:
                ewc_importance[n] += (p.grad.detach() ** 2)
    # Normalize and snapshot
    for n in ewc_importance: ewc_importance[n] /= len(fisher_loader)
    ewc_star = {n: p.detach().clone() for n, p in model.named_parameters()}
```

- **Label:** Start with this hybrid; add adapters for domain-specific heads and a tiny validation guard to detect drift before expansion.

