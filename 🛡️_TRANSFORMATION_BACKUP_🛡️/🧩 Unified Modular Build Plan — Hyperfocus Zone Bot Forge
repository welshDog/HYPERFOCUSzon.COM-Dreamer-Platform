### **6. Example Cog Skeleton (merged style)**

```python
import discord
from discord.ext import commands

class GuardianSpirits(commands.Cog):
    def __init__(self, bot):
        self.bot = bot

    @commands.command(name="banish")
    @commands.has_permissions(kick_members=True)
    async def banish(self, ctx, member: discord.Member, *, reason=None):
        await member.ban(reason=reason)
        await ctx.send(
            embed=discord.Embed(
                title="⚡ The Flame Spirit Strikes!",
                description=f"{member.display_name} has been banished 🔥\nReason: {reason or 'No reason given'}",
                color=discord.Color.red()
            )
        )

async def setup(bot):
    await bot.add_cog(GuardianSpirits(bot))
```

