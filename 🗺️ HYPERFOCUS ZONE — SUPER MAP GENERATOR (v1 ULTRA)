import os
import datetime

# --- CONFIG ---
ROOTS = [
    ".",  # Current folder, or set to "HYPERFOCUS_ZONE" etc.
]
EMOJI_MAP = {
    "portal": "🏛️",
    "ai": "🤖",
    "memory": "💎",
    "products": "🎮",
    "blog": "✍️",
    "security": "🔐",
    "marketing": "📢",
    "dook": "🌀",
    "priority": "🔥",
    "docs": "📄",
}
EXT_EMOJI = {
    ".md": "📝",
    ".py": "🐍",
    ".json": "🧬",
    ".sh": "💻",
    ".yml": "⚙️",
    ".txt": "📄",
    ".js": "💡",
    ".png": "🖼️",
    ".jpg": "🖼️",
    ".mp4": "🎬",
}
PRIORITY_KEYWORDS = ["🔥", "PRIORITY", "Ultra", "Legendary"]

# --- LOGIC ---
def folder_emoji(name):
    key = name.lower().split("_")[0]
    return EMOJI_MAP.get(key, "📁")

def file_emoji(name):
    ext = os.path.splitext(name)[1].lower()
    for p in PRIORITY_KEYWORDS:
        if p.lower() in name.lower():
            return "🔥"
    return EXT_EMOJI.get(ext, "📄")

def map_dir(root, prefix=""):
    output = ""
    try:
        items = sorted(os.listdir(root))
    except Exception:
        return ""
    for item in items:
        if item.startswith(".") or "venv" in item:  # Skip hidden/system/venv
            continue
        full = os.path.join(root, item)
        if os.path.isdir(full):
            emoji = folder_emoji(item)
            output += f"{prefix}- {emoji} **/{item}/**\n"
            output += map_dir(full, prefix + "    ")
        else:
            emoji = file_emoji(item)
            output += f"{prefix}- {emoji} {item}\n"
    return output

def main():
    dt = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
    header = f"# 🗺️ HYPERFOCUS ZONE — SUPER STRUCTURE MAP\n\n_Last Updated: {dt}_\n\n"
    header += "Dream it. Build it. Hyperfocus Zone. 🧠⚡\n\n---\n\n"
    body = ""
    for root in ROOTS:
        body += map_dir(root)
    with open("SUPER_MAP.md", "w", encoding="utf-8") as f:
        f.write(header + body)
    print("🔥 SUPER_MAP.md generated! GO FIND THAT GOLD, CHIEF! 🔥")

if __name__ == "__main__":
    main()
