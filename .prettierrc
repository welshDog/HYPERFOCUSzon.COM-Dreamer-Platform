{
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "endOfLine": "lf",
    "proseWrap": "preserve",
    "ignore": [
        "**/*.py",
        "**/*.md",
        "**/*.txt",
        "**/node_modules/**",
        "**/dist/**",
        "**/build/**",
        "**/*💎*",
        "**/*⚡*",
        "**/*🚀*",
        "**/*🧠*",
        "**/*🏆*"
    ]
}
