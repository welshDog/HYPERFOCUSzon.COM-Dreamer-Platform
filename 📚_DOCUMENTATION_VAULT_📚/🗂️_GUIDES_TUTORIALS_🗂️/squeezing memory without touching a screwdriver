# 3 — Memory Oracle (desktop notifications) — `memory_oracle_win.py`

Uses `win10toast` to pop a toast when the top process exceeds threshold. Tuned threshold **THRESH\_MB = 900**.

```python
#!/usr/bin/env python3
# memory_oracle_win.py
# requires: pip install psutil win10toast

import time, psutil
from win10toast import ToastNotifier

THRESH_MB = 900
CHECK_INTERVAL = 12

toaster = ToastNotifier()

def top_processes(n=3):
    procs = sorted(psutil.process_iter(['name','memory_info']), key=lambda p: (p.info['memory_info'].rss if p.info['memory_info'] else 0), reverse=True)
    out = []
    for p in procs[:n]:
        try:
            mem = p.info['memory_info'].rss // 1024**2
            out.append((p.info['name'], mem))
        except Exception:
            continue
    return out

if __name__ == "__main__":
    while True:
        tops = top_processes(4)
        msg_lines = [f"{name}: {mem}MB" for name, mem in tops]
        if any(mem > THRESH_MB for _, mem in tops):
            toaster.show_toast("Memory Oracle", "\n".join(msg_lines), duration=6, threaded=True)
        time.sleep(CHECK_INTERVAL)
```

Customize: change `THRESH_MB` if you want earlier/later warnings.

