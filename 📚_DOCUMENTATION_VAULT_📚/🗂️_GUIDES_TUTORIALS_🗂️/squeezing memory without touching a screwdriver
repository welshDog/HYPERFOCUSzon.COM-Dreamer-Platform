# 2 — Windows-tailored memory\_watchdog (drop as `memory_watchdog_win.py`)

Defaults chosen for your 8GB: per-process limit **LIMIT\_MB = 900** (you can raise to 1200 if you want fewer restarts). Targets include common heavy apps; edit `targets` to match your real processes.

```python
#!/usr/bin/env python3
# memory_watchdog_win.py  (for Windows 10/11)
# requires: pip install psutil

import time, subprocess, shlex, psutil
from pathlib import Path

# --- CONFIG (edit these) ---
CHECK_INTERVAL = 6    # seconds between checks
LIMIT_MB = 900        # per-process memory limit in MB (sensible for 8GB RAM)
LOG_FILE = Path.home() / "memory_watchdog.log"

# target process names (case-insensitive substrings). If restart_cmd is None,
# the script will attempt a graceful terminate; if restart_cmd set, it will run it.
# EDIT: change or add your own process names (eg "Code.exe", "chrome.exe", "msedge.exe", "discord.exe")
targets = [
    ("chrome", None),
    ("msedge", None),
    ("Code.exe", None),          # VSCode
    ("discord", None),
    ("python", None),
]

def log(msg):
    line = f"{time.strftime('%Y-%m-%d %H:%M:%S')}  {msg}"
    print(line)
    try:
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(line + "\n")
    except Exception:
        pass

def restart_cmd(cmd):
    try:
        subprocess.Popen(shlex.split(cmd))
    except Exception as e:
        log(f"failed to start '{cmd}': {e}")

def try_terminate(p):
    try:
        p.terminate()
        gone, alive = psutil.wait_procs([p], timeout=5)
        if alive:
            p.kill()
    except Exception as e:
        log(f"error terminating pid {p.pid}: {e}")

def monitor_once():
    procs = list(psutil.process_iter(['pid','name','cmdline','memory_info']))
    for name_sub, cmd in targets:
        name_sub_lower = name_sub.lower()
        matched = [p for p in procs if (p.info['name'] or "").lower().find(name_sub_lower) != -1 or any(name_sub_lower in (c or "").lower() for c in (p.info['cmdline'] or []))]
        for p in matched:
            try:
                mem_mb = p.info['memory_info'].rss / 1024**2
            except Exception:
                continue
            if mem_mb > LIMIT_MB:
                log(f"⚠ {p.info['name']} (pid {p.pid}) using {mem_mb:.0f}MB > {LIMIT_MB}MB")
                # terminate & optionally restart
                try_terminate(p)
                if cmd:
                    restart_cmd(cmd)

    vm = psutil.virtual_memory()
    if vm.available / 1024**2 < 300:
        log("🔥 System available memory < 300MB — overall pressure is high")

if __name__ == "__main__":
    log("Memory Watchdog starting (Windows mode).")
    while True:
        monitor_once()
        time.sleep(CHECK_INTERVAL)
```

How to run:

* Save file, open PowerShell, run `python memory_watchdog_win.py`.
* To run in background: create a Task Scheduler task (instructions below).

