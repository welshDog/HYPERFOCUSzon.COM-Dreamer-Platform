3) Hardened health-check Python snippet (handles Docker missing + UTF-8 logging)
Drop this into your health check script — it: sets UTF-8 logging, checks Docker safely, retries with backoff, and logs friendly errors instead of repeated warnings.

python
Copy
Edit
#!/usr/bin/env python3
import logging
import sys
import time

# ---------- Logging (UTF-8) ----------
logger = logging.getLogger("legendary-health")
logger.setLevel(logging.INFO)

ch = logging.StreamHandler(sys.stdout)
ch.setFormatter(logging.Formatter("%(asctime)s - %(levelname)s - %(message)s"))
logger.addHandler(ch)

fh = logging.FileHandler("legendary_health_check.log", encoding="utf-8")
fh.setFormatter(logging.Formatter("%(asctime)s - %(levelname)s - %(message)s"))
logger.addHandler(fh)

# ---------- Docker check (safe) ----------
def check_docker():
    try:
        import docker
    except Exception:
        logger.warning("docker SDK not installed. Skipping docker checks.")
        return False

    try:
        client = docker.from_env(timeout=3)
        # quick ping
        client.ping()
        logger.info("Docker daemon reachable ✅")
        return True
    except Exception as e:
        # single clear warning, with exception details
        logger.warning("Docker check failed: %s", str(e))
        return False

# ---------- Retry wrapper (avoid spam) ----------
def retry_check(fn, tries=3, initial_delay=2):
    delay = initial_delay
    for attempt in range(1, tries+1):
        ok = fn()
        if ok:
            return True
        if attempt < tries:
            logger.info("Retrying in %s seconds (attempt %d/%d)...", delay, attempt+1, tries)
            time.sleep(delay)
            delay *= 2
    return False

if __name__ == "__main__":
    logger.info("Starting legendary health check 💎")
    docker_ok = retry_check(check_docker, tries=3, initial_delay=2)
    if not docker_ok:
        logger.warning("Docker unavailable after retries. Ensure Docker daemon is installed and running.")
    else:
        logger.info("All docker checks passed.")

    logger.info("Health check finished.")
