import sqlite3
import datetime
import random
from typing import List, Dict, Optional

class FocusPodsManager:
    """🤝 Focus Pods - Small accountability groups for neurodivergent focus"""

    def __init__(self):
        self.setup_database()

    def setup_database(self):
        """Initialize Focus Pods database"""
        conn = sqlite3.connect('focus_pods.db')
        cursor = conn.cursor()

        # Focus Pods table
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS focus_pods (
                id TEXT PRIMARY KEY,
                name TEXT NOT NULL,
                description TEXT,
                max_members INTEGER DEFAULT 6,
                focus_type TEXT,
                meeting_schedule TEXT,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                active BOOLEAN DEFAULT 1
            )
        """)

        # Pod Members table
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS pod_members (
                pod_id TEXT,
                user_id TEXT,
                role TEXT DEFAULT 'member',
                joined_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                focus_streak INTEGER DEFAULT 0,
                total_sessions INTEGER DEFAULT 0,
                FOREIGN KEY (pod_id) REFERENCES focus_pods (id)
            )
        """)

        # Focus Sessions table
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS focus_sessions (
                id TEXT PRIMARY KEY,
                pod_id TEXT,
                session_type TEXT,
                start_time TIMESTAMP,
                duration_minutes INTEGER,
                participants TEXT,
                session_data TEXT,
                FOREIGN KEY (pod_id) REFERENCES focus_pods (id)
            )
        """)

        conn.commit()
        conn.close()

    def create_pod(self, name: str, description: str, focus_type: str, creator_id: str) -> Dict:
        """🚀 Create new Focus Pod"""
        pod_id = f"pod_{int(datetime.datetime.now().timestamp())}_{random.randint(1000, 9999)}"

        conn = sqlite3.connect('focus_pods.db')
        cursor = conn.cursor()

        # Create pod
        cursor.execute("""
            INSERT INTO focus_pods (id, name, description, focus_type)
            VALUES (?, ?, ?, ?)
        """, (pod_id, name, description, focus_type))

        # Add creator as admin
        cursor.execute("""
            INSERT INTO pod_members (pod_id, user_id, role)
            VALUES (?, ?, 'admin')
        """, (pod_id, creator_id))

        conn.commit()
        conn.close()

        return {
            "pod_id": pod_id,
            "name": name,
            "status": "created",
            "message": f"🎉 Focus Pod '{name}' created successfully!"
        }

