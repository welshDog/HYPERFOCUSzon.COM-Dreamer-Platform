import { useEffect, useState } from 'react';

export default function Home() {
  const [chapters, setChapters] = useState([]);
  const [selected, setSelected] = useState(0);

  useEffect(() => {
    fetch('/api/chapters')
      .then(res => res.json())
      .then(setChapters);
  }, []);

  return (
    <main>
      <aside>
        {chapters.map((ch, i) => (
          <button key={i} onClick={() => setSelected(i)}>{ch.fname}</button>
        ))}
      </aside>
      <article>
        <pre>{chapters[selected]?.content || 'Pick a chapter!'}</pre>
      </article>
    </main>
  );
}
