// Simple API to load chapters from 'dook/' directory (Node.js/Next.js)
// Replace with dynamic loader as you grow!
import fs from 'fs';
import path from 'path';

export default function handler(req, res) {
  const dir = path.resolve(process.cwd(), 'dook');
  const files = fs.readdirSync(dir).filter(f => f.endsWith('.md'));
  const chapters = files.map(fname => {
    const content = fs.readFileSync(path.join(dir, fname), 'utf8');
    // Optionally parse frontmatter here!
    return { fname, content };
  });
  res.status(200).json(chapters);
}
