build.sh
bash
Copy
Edit
#!/bin/bash

# Convert all Markdown and AsciiDoc to one big book
pandoc src/chapters/*.md src/chapters/*.adoc \
  -o UltraDook.pdf --metadata-file=book.yaml --toc --pdf-engine=xelatex

pandoc src/chapters/*.md src/chapters/*.adoc \
  -s -o site/index.html --metadata-file=book.yaml --toc

# EPUB version too!
pandoc src/chapters/*.md src/chapters/*.adoc \
  -o UltraDook.epub --metadata-file=book.yaml --toc
Make executable with: chmod +x build.sh

