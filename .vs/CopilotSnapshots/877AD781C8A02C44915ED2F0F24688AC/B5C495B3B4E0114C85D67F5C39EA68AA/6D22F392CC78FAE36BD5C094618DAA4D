#!/usr/bin/env python3
"""
Quick Server Connection - One-liner script
"""

import paramiko
import getpass
import sys

def quick_connect():
    """Quick connection to server"""
    try:
        # Server details
        hostname = '212.227.127.144'
        username = 'root'
        port = 22
        
        # Create SSH client
        ssh = paramiko.SSHClient()
        ssh.set_missing_host_key_policy(paramiko.AutoAddPolicy())
        
        print(f"Connecting to {hostname}...")
        
        # Try to connect (will prompt for password)
        password = getpass.getpass(f"Password for {username}@{hostname}: ")
        ssh.connect(hostname, username=username, password=password, port=port)
        
        print("✅ Connected!")
        
        # Interactive shell
        while True:
            cmd = input(f"{username}@{hostname}:~$ ").strip()
            if cmd.lower() in ['exit', 'quit']:
                break
            if cmd:
                stdin, stdout, stderr = ssh.exec_command(cmd)
                output = stdout.read().decode('utf-8')
                error = stderr.read().decode('utf-8')
                if output:
                    print(output)
                if error:
                    print(f"Error: {error}")
        
        ssh.close()
        print("Connection closed.")
        
    except Exception as e:
        print(f"Connection failed: {e}")
        sys.exit(1)

if __name__ == "__main__":
    quick_connect()