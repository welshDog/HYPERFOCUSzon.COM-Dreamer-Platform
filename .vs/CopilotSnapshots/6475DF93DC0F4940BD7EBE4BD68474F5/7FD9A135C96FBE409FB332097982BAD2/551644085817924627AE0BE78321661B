    def cleanup(self):
        """Cleanup connections and save session data"""
        if self.connected:
            if self.sftp:
                self.sftp.close()
            if self.ssh:
                self.ssh.close()
            console.print("[green]✅ Connection closed.[/green]")
            self.logger.info("Session ended")
        
        # Save command history if enabled
        if ADVANCED_FEATURES.get('save_session_history') and self.command_history:
            history_file = Path('session_history.json')
            try:
                with open(history_file, 'w') as f:
                    json.dump(self.command_history, f, indent=2)
                console.print(f"[green]✅ Session history saved to {history_file}[/green]")
            except Exception as e:
                console.print(f"[red]❌ Failed to save history: {e}[/red]")

