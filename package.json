{
    "name": "hyperfocus-zone-empire",
    "version": "2.0.0",
    "description": "HYPERFOCUS ZONE - Ultimate ADHD Productivity Empire with 1,050+ AI agents and neurodivergent-friendly automation",
    "main": "index.html",
    "scripts": {
        "dev": "npx http-server . -p 8080 -o",
        "build": "echo 'Static site ready for production!'",
        "deploy:vercel": "vercel --prod",
        "deploy:netlify": "netlify deploy --prod --dir=.",
        "preview": "npx http-server . -p 3000 -o"
    },
    "keywords": [
        "ADHD",
        "productivity",
        "neurodivergent",
        "AI-agents",
        "hyperfocus",
        "dopamine-tracking",
        "automation",
        "accessibility",
        "portal-navigation"
    ],
    "author": "HYPERFOCUS ZONE Empire <SEND-ME.NFT@UD.ME>",
    "license": "MIT",
    "homepage": "https://hyperfocuszone.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/welshDog/HYPERFOCUSzon.COM-V10.git"
    },
    "bugs": {
        "url": "https://github.com/welshDog/HYPERFOCUSzon.COM-V10/issues"
    },
    "engines": {
        "node": ">=16.0.0"
    },
    "devDependencies": {
        "http-server": "^14.1.1"
    },
    "config": {
        "deployment": {
            "vercel": {
                "project": "hyperfocus-zone-empire",
                "framework": "other"
            },
            "netlify": {
                "site": "hyperfocus-zone-empire",
                "build_command": "echo 'Ready!'",
                "publish_directory": "."
            }
        }
    }
