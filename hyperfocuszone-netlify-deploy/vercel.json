{
  "name": "hyperfocuszone-live",
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/support/(.*)",
      "dest": "/support/index.html"
    },
    {
      "src": "/enterprise/(.*)",
      "dest": "/enterprise/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {},
  "rewrites": [
    {
      "source": "/support/(.*)",
      "destination": "/support/index.html"
    },
    {
      "source": "/enterprise/(.*)",
      "destination": "/enterprise/index.html"
    }
  ]
}