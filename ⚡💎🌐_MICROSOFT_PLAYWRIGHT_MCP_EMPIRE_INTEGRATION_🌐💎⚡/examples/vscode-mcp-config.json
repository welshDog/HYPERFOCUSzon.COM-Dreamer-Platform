{
    "name": "vs-code-mcp-playwright-empire",
    "version": "1.0.0",
    "description": "VS Code MCP configuration for HyperFocus Empire Playwright integration",
    "mcpServers": {
        "playwright-empire": {
            "command": "npx",
            "args": [
                "@playwright/mcp@latest",
                "--browser",
                "chrome",
                "--headless",
                "--allowed-origins",
                "hyperfocuszone.com;localhost;127.0.0.1;*.ai;github.com;*.github.com;npmjs.com;*.npmjs.com;stackoverflow.com;openai.com;claude.ai",
                "--blocked-origins",
                "ads.google.com;googleadservices.com;facebook.com/tr;analytics.google.com;googletagmanager.com;hotjar.com",
                "--save-session",
                "--save-trace",
                "--output-dir",
                "./empire-automation-logs",
                "--user-agent",
                "HyperFocus-Empire-Agent/1.0",
                "--viewport-size",
                "1920,1080",
                "--ignore-https-errors",
                "--no-sandbox"
            ]
        },
        "playwright-empire-testing": {
            "command": "npx",
            "args": [
                "@playwright/mcp@latest",
                "--browser",
                "chrome",
                "--allowed-origins",
                "localhost;127.0.0.1;*.local",
                "--isolated",
                "--output-dir",
                "./empire-testing-logs",
                "--user-agent",
                "HyperFocus-Empire-Testing-Agent/1.0",
                "--viewport-size",
                "1280,720"
            ]
        },
        "playwright-empire-secure": {
            "command": "npx",
            "args": [
                "@playwright/mcp@latest",
                "--browser",
                "chrome",
                "--headless",
                "--isolated",
                "--allowed-origins",
                "hyperfocuszone.com;*.hyperfocuszone.com",
                "--blocked-origins",
                "ads.google.com;facebook.com;analytics.google.com;googletagmanager.com;hotjar.com;fullstory.com;mixpanel.com",
                "--save-trace",
                "--output-dir",
                "./empire-secure-logs",
                "--user-agent",
                "HyperFocus-Empire-Secure-Agent/1.0"
            ]
        }
    },
    "configurations": {
        "development": {
            "server": "playwright-empire-testing",
            "headed": true,
            "isolation": true,
            "tracing": true
        },
        "production": {
            "server": "playwright-empire",
            "headed": false,
            "isolation": false,
            "session_persistence": true
        },
        "security_audit": {
            "server": "playwright-empire-secure",
            "headed": false,
            "isolation": true,
            "strict_origins": true
        }
    },
    "empire_integration": {
        "broskie_orchestrator": {
            "enabled": true,
            "mission_reporting": true,
            "agent_coordination": true
        },
        "aria_intelligence": {
            "enabled": true,
            "behavioral_analysis": true,
            "decision_support": true
        },
        "memory_crystals": {
            "enabled": true,
            "pattern_storage": true,
            "learning_enhancement": true
        },
        "monitoring": {
            "grafana_integration": true,
            "loki_logging": true,
            "prometheus_metrics": true
        }
    },
    "installation_commands": {
        "global_install": "npm install -g @playwright/mcp@latest",
        "browser_install": "npx playwright install",
        "deps_install": "npx playwright install-deps",
        "test_install": "npx @playwright/mcp@latest --help"
    },
    "quick_start": {
        "1": "Install Node.js 18+ if not present",
        "2": "Run: npm install -g @playwright/mcp@latest",
        "3": "Run: npx playwright install",
        "4": "Copy this config to VS Code settings.json mcpServers section",
        "5": "Restart VS Code to load MCP configuration",
        "6": "Test with: 'Navigate to https://example.com'"
    },
    "example_prompts": [
        "Navigate to https://github.com/microsoft/playwright-mcp",
        "Take a screenshot of the current page",
        "Extract all links from this page",
        "Click on the 'Issues' tab",
        "Fill in a search form with 'browser automation'",
        "Generate a PDF of this documentation page",
        "Open a new tab and navigate to VS Code marketplace",
        "Check if element with selector '.repo-name' exists",
        "Get the page title and URL",
        "Scroll to the bottom of the page"
    ],
    "troubleshooting": {
        "node_not_found": "Install Node.js from https://nodejs.org/",
        "playwright_install_fails": "Run as administrator or use --unsafe-perm flag",
        "browser_crashes": "Try --no-sandbox flag or install browser dependencies",
        "permission_denied": "Check file permissions in output directory",
        "mcp_not_loading": "Restart VS Code and check syntax in settings.json"
    }
}