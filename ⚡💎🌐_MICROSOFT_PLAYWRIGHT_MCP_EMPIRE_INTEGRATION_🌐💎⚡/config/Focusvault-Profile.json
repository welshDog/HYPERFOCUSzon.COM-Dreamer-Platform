{
    "security_profile": "empire_standard",
    "version": "1.0.0",
    "created": "2025-08-10",
    "description": "HyperFocus AI Empire security configuration for Playwright MCP",
    "network_security": {
        "allowed_domains": [
            "hyperfocuszone.com",
            "*.hyperfocuszone.com",
            "localhost",
            "127.0.0.1",
            "*.local",
            "github.com",
            "api.github.com",
            "raw.githubusercontent.com",
            "npmjs.com",
            "registry.npmjs.org",
            "unpkg.com",
            "cdn.jsdelivr.net",
            "stacknoverflow.com",
            "developer.mozilla.org",
            "w3.org",
            "openai.com",
            "api.openai.com",
            "claude.ai",
            "api.claude.ai",
            "anthropic.com"
        ],
        "blocked_domains": [
            "ads.google.com",
            "googleadservices.com",
            "googlesyndication.com",
            "doubleclick.net",
            "facebook.com/tr",
            "connect.facebook.net",
            "analytics.google.com",
            "googletagmanager.com",
            "google-analytics.com",
            "hotjar.com",
            "fullstory.com",
            "mixpanel.com",
            "segment.com",
            "intercom.io",
            "zendesk.com/embeddable_framework",
            "crisp.chat",
            "tawk.to"
        ],
        "proxy_settings": {
            "enabled": false,
            "bypass_domains": [
                ".local",
                "localhost",
                "127.0.0.1"
            ]
        }
    },
    "browser_security": {
        "sandbox": {
            "enabled": false,
            "reason": "Empire agents require elevated permissions"
        },
        "https": {
            "ignore_errors": true,
            "reason": "Development and internal testing environments"
        },
        "permissions": {
            "camera": false,
            "microphone": false,
            "geolocation": true,
            "notifications": true,
            "clipboard": true
        },
        "user_agent": "HyperFocus-Empire-Agent/1.0 (Playwright MCP; AI-Powered; Security-Audited)",
        "additional_chrome_args": [
            "--disable-blink-features=AutomationControlled",
            "--disable-dev-shm-usage",
            "--disable-extensions",
            "--disable-plugins",
            "--disable-images",
            "--disable-javascript",
            "--disable-notifications"
        ]
    },
    "session_security": {
        "isolation": {
            "default_mode": "persistent",
            "testing_mode": "isolated",
            "high_security_mode": "isolated"
        },
        "storage": {
            "save_cookies": true,
            "save_local_storage": true,
            "save_session_storage": false,
            "clear_on_exit": false
        },
        "data_retention": {
            "session_logs": "30_days",
            "trace_files": "7_days",
            "screenshots": "14_days",
            "pdfs": "90_days"
        }
    },
    "audit_and_logging": {
        "enabled": true,
        "log_level": "info",
        "trace_all_requests": true,
        "screenshot_on_failure": true,
        "log_destinations": [
            "file",
            "loki",
            "console"
        ],
        "sensitive_data_scrubbing": {
            "passwords": true,
            "api_keys": true,
            "tokens": true,
            "emails": false,
            "phone_numbers": false
        }
    },
    "empire_integration": {
        "broskie_orchestrator": {
            "enabled": true,
            "report_metrics": true,
            "escalation_on_security_breach": true
        },
        "aria_intelligence": {
            "enabled": true,
            "share_behavioral_data": true,
            "ai_decision_logging": true
        },
        "memory_crystals": {
            "enabled": true,
            "store_successful_patterns": true,
            "store_failure_patterns": true
        }
    },
    "compliance": {
        "gdpr_compliance": true,
        "data_anonymization": true,
        "audit_trail": true,
        "retention_policies": true
    },
    "emergency_procedures": {
        "kill_switch": {
            "enabled": true,
            "trigger_file": "./EMERGENCY_STOP",
            "action": "terminate_all_sessions"
        },
        "security_breach_response": {
            "isolate_session": true,
            "alert_administrators": true,
            "preserve_evidence": true,
            "auto_terminate": false
        }
    }
}