{
    "mcp": {
        "mcpServers": {
            "playwright-empire": {
                "command": "npx",
                "args": [
                    "@playwright/mcp@latest",
                    "--browser",
                    "chrome",
                    "--headless",
                    "--allowed-origins",
                    "hyperfocuszone.com;localhost;*.ai;github.com",
                    "--save-session",
                    "--save-trace",
                    "--output-dir",
                    "./playwright-empire-logs",
                    "--user-agent",
                    "HyperFocus-Empire-Agent/1.0"
                ]
            }
        }
    }
}