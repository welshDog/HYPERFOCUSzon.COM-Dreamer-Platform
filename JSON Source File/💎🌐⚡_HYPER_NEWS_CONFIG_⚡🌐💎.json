{
    "portal_config": {
        "name": "💎🌐⚡ HYPER NEWS Web3 AUTO Portal ⚡🌐💎",
        "version": "1.0.0",
        "port": 5001,
        "auto_launch_browser": true,
        "debug_mode": false
    },
    "news_sources": {
        "coindesk": {
            "name": "CoinDesk",
            "url": "https://www.coindesk.com/arc/outboundfeeds/rss/",
            "enabled": true,
            "priority": 1,
            "update_interval": 300
        },
        "cointelegraph": {
            "name": "Cointelegraph",
            "url": "https://cointelegraph.com/rss",
            "enabled": true,
            "priority": 1,
            "update_interval": 300
        },
        "theblock": {
            "name": "The Block",
            "url": "https://www.theblock.co/rss.xml",
            "enabled": true,
            "priority": 2,
            "update_interval": 600
        },
        "decrypt": {
            "name": "Decrypt",
            "url": "https://decrypt.co/feed",
            "enabled": true,
            "priority": 2,
            "update_interval": 600
        },
        "ethereum_blog": {
            "name": "Ethereum Blog",
            "url": "https://blog.ethereum.org/feed.xml",
            "enabled": true,
            "priority": 1,
            "update_interval": 900
        },
        "openai_blog": {
            "name": "OpenAI Updates",
            "url": "https://openai.com/blog/rss.xml",
            "enabled": true,
            "priority": 1,
            "update_interval": 1800
        }
    },
    "web3_keywords": [
        "web3",
        "blockchain",
        "crypto",
        "cryptocurrency",
        "bitcoin",
        "ethereum",
        "defi",
        "decentralized",
        "nft",
