        "altcoin",
        "cbdc",
        "artificial intelligence",
        "ai",
        "machine learning",
        "automation",
        "trading bot",
        "algorithmic trading"
    ],
    "ai_config": {
        "openai_api_key": "",
        "model": "gpt-3.5-turbo",
        "max_tokens": 500,
        "temperature": 0.7,
        "summary_interval": 600,
        "sentiment_analysis": true,
        "trend_detection": true
    },
    "portal_integration": {
        "admin_portal": {
            "enabled": true,
            "url": "http://localhost:8000",
            "auto_publish": true,
            "notification_types": [
                "breaking",
                "market_analysis"
            ]
        },
        "creator_portal": {
            "enabled": true,
            "url": "http://localhost:3001",
            "auto_publish": true,
            "content_types": [
                "article_ideas",
                "trending_topics"
            ]
        },
        "discord_bot": {
            "enabled": false,
            "webhook_url": "",
            "channels": [
                "#ai-news",
                "#web3-updates"
            ],
            "mention_roles": [
                "@crypto-enthusiasts"
            ]
        },
        "blog_portal": {
            "enabled": true,
            "auto_publish": false,
            "draft_mode": true,
            "categories": [
                "Web3",
                "AI",
                "Blockchain",
                "DeFi"
            ]
        },
        "twitter": {
            "enabled": false,
            "api_key": "",
            "api_secret": "",
            "access_token": "",
            "access_token_secret": "",
            "hashtags": [
                "#Web3",
                "#Crypto",
                "#AI",
                "#BROski"
            ]
        }
    },
    "broskie_rewards": {
        "enabled": true,
        "auto_scan_activation": 25,
        "ai_summary_generation": 50,
        "portal_publishing": 15,
        "news_contribution": 100,
        "trend_prediction": 200,
        "community_engagement": 10,
        "system_optimization": 75
    },
    "scheduling": {
        "daily_digest": {
            "enabled": true,
            "time": "09:00",
            "timezone": "UTC"
        },
        "weekly_report": {
            "enabled": true,
            "day": "friday",
            "time": "17:00",
            "timezone": "UTC"
        },
        "market_analysis": {
            "enabled": true,
            "interval_hours": 4
        },
        "breaking_news": {
            "enabled": true,
            "threshold_score": 0.8,
            "immediate_publish": true
        }
    },
    "ui_config": {
        "theme": "legendary",
        "animations_enabled": true,
        "celebration_effects": true,
        "auto_refresh_interval": 30,
        "max_news_items_display": 50,
        "compact_mode": false
    },
    "analytics": {
        "track_user_engagement": true,
        "sentiment_tracking": true,
        "trend_analysis": true,
        "performance_monitoring": true,
        "data_retention_days": 30
    },
    "security": {
        "rate_limiting": true,
        "api_authentication": false,
        "cors_enabled": true,
        "allowed_origins": [
            "http://localhost:*"
        ],
        "log_level": "INFO"
    },
    "experimental_features": {
        "blockchain_publishing": false,
        "ipfs_storage": false,
        "dao_integration": false,
        "nft_rewards": false,
        "predictive_analytics": false,
        "multi_language": false
    }
}